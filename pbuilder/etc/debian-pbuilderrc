## Mirror configuration
MIRRORSITE=http://deb.debian.org/debian
# OTHERMIRROR="deb http://deb.debian.org/debian stable-backports main"
## Enabled components (add "contrib non-free non-free-firmware" if needed)
# COMPONENTS="main contrib non-free non-free-firmware"
## Options to debootstrap
DEBOOTSTRAPOPTS=(
    '--variant=buildd'
    '--keyring=/usr/share/keyrings/debian-archive-keyring.gpg'
    )
## Assume /tmp or /tmp/pbuilder is tmpfs
BUILDPLACE=/tmp/pbuilder
## No hard linking for tmpfs
APTCACHEHARDLINK=no
## kfreebsd, use this
# USEDEVFS=yes
## Seperate APT cache, not enabled by default
# APTCACHE="$HOME/pbuilder/aptcache/$DIST-$ARCH/"
## ccache — persist compiler cache across builds
export CCACHEDIR="/var/cache/pbuilder/ccache"
#export PATH="/usr/lib/ccache:${PATH}"
EXTRAPACKAGES="ccache eatmydata"
#BINDMOUNTS="${CCACHE_DIR}"
## eatmydata — skip fsyncs to speed up package installs
EATMYDATA=yes
## Parallel build (set here so sudoers does not need SETENV)
export DEB_BUILD_OPTIONS="parallel=$(nproc)"
